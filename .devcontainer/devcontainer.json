{
  "name": "nyc-taxi-lakehouse",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "17" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "secrets": {
    "DATABRICKS_HOST": { "description": "Workspace URL, e.g. https://<id>.cloud.databricks.com" },
    "DATABRICKS_TOKEN": { "description": "Personal access token from User Settings > Developer" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
